<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny offline SVG -> PNG rasterizer for the app's header icons.
       The renderer is self-contained (System.Drawing / GDI+ only, no OS
       image codecs) and has zero NuGet dependencies, so the "no extra
       deps" rule and offline builds hold for the tooling as well. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SvgToPng</AssemblyName>
    <RootNamespace>SvgToPng</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pulls in System.Drawing.Common (GDI+) from the installed framework. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
