<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny offline SVG->PNG rasterizer for the app's header icons.
       Decoding goes through WIC (System.Drawing on .NET uses the Windows
       Imaging Component under the hood, which ships a built-in SVG codec) -
       no third-party codec or NuGet package, so the "no extra deps" rule
       and offline builds hold for the tooling as well. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SvgToPng</AssemblyName>
    <RootNamespace>SvgToPng</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

</Project>
