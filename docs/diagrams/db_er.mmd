%% Neo Library — ER-диаграмма каталога (SQLite, library.db, v7)
%% Произведение, издание и список жанров. Локальный скан: один новый путь = одно произведение.
erDiagram

    works {
        INTEGER   _id          PK "AUTOINCREMENT; id произведения; в курсоре это Book.id"
        TEXT      title        "заголовок каталога (сначала — из имени файла)"
        TEXT      author       "автор"
        TEXT      publisher    "издатель"
        TEXT      description  "описание / заметки"
        TEXT      series       "серия (опц.)"
        INTEGER   user_edited  "0/1 NOT NULL; пользователь правил поля"
        INTEGER   last_read    "epoch millis; NULL = не читали"
        TEXT      remote_id    "под сервер; писатели оставляют NULL"
        INTEGER   revision     "NOT NULL DEFAULT 0; писатели не увеличивают"
        INTEGER   deleted      "NOT NULL DEFAULT 0; deleted=1 скрыто из чтений каталога"
    }

    files {
        INTEGER   _id          PK "AUTOINCREMENT; id издания, не равен id произведения"
        INTEGER   work_id      FK "REFERENCES works(_id); каскада нет"
        TEXT      format       "канонический id: EPUB, FB2, PDF... (scan/Formats.ALL)"
        TEXT      path         UK "абсолютный путь — ключ издания; NULL допустим, писатели путь задают"
        TEXT      remote_key   "под сервер; писатели оставляют NULL"
        INTEGER   size_bytes   "размер файла, байты"
        TEXT      content_hash "под сервер; писатели оставляют NULL"
        INTEGER   exported     "0/1: метаданные файла редактировались на диске (EPUB/FB2)"
        INTEGER   meta_done    "0/1 NOT NULL; очередь enrich: meta_done=0"
        INTEGER   meta_failed  "0/1 NOT NULL; парсинг перелетел 2-мин бюджет, берётся последним"
        TEXT      availability "NOT NULL DEFAULT local; писатели не меняют"
    }

    work_genres {
        INTEGER   work_id      FK "REFERENCES works(_id); UNIQUE вместе с position и с name"
        INTEGER   position     "порядок с нуля"
        TEXT      name         "жанр, нижний регистр Locale.ROOT"
    }

    book_model {
        long      id           "works._id; до сохранения -1"
        String    path         "files.path издания, которое попало в курсор"
        String    format       "files.format"
        String    title
        String    author
        String    publisher
        String    description
        String    series
        ArrayList genres       "порядок position; пустой список = жанра нет; курсор списка его не несёт"
        long      sizeBytes
        boolean   exported
        boolean   metaDone
        boolean   metaFailed
        boolean   userEdited
    }

    book_database {
        SQLiteOpenHelper db "library.db, DB_VERSION=7"
        long    upsert               "по path: текст произведения и список жанров; last_read, флаги и серверные колонки не пишет"
        long    upsertBasic          "новый путь = новое произведение и одно local-издание; у существующего — только format и size; жанры не трогает"
        void    updateMetadata       "список жанров как series: заменить, если user_edited=0 или список пуст; meta_done=1, meta_failed=0"
        void    markRead             "works.last_read = now"
        void    markMetaPending      "files.meta_done=0, meta_failed=0 и works.user_edited=0; строки жанров остаются"
        void    markMetaFailed       "files.meta_failed=1"
        void    markUserEdited       "works.user_edited=1"
        void    clear                "work_genres, files, works; вызывающий ещё и CoverCache.clear"
        List    needMeta             "files.meta_done=0 ORDER BY meta_failed, works._id"
        Cursor  cursorAll            "JOIN works+files; фильтр жанра = EXISTS по work_genres"
    }

    book_provider {
        ContentProvider provider "read-only"
        Uri CONTENT_URI  "content://com.example.mylibrary.books/books"
        Uri RECENT_URI   "content://com.example.mylibrary.books/books/recent"
        Cursor query     "грамматика genre IN остаётся; SQL внутри cursorAll"
    }

    works ||--o{ files : "издание"
    works ||--o{ work_genres : "жанры"
    book_model }o--|| works : "id произведения"
    book_model }o--|| files : "path и format издания"
    book_database ||--|| works : "владелец схемы"
    book_database ||--|| files : "владелец схемы"
    book_database ||--|| work_genres : "владелец схемы"
    book_provider }o--|| book_database : "query только чтение"
