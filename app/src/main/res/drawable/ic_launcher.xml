<?xml version="1.0" encoding="utf-8"?>
<!-- Simple placeholder launcher icon that works on API 19 (no vector support). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3F51B5" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
        <size android:width="24dp" android:height="6dp" />
    </item>
    <item android:gravity="center" android:top="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
        <size android:width="24dp" android:height="6dp" />
    </item>
    <item android:gravity="center" android:top="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
        <size android:width="24dp" android:height="6dp" />
    </item>
</layer-list>
