<?xml version="1.0" encoding="utf-8"?>
<!-- Tile (grid) layout, per the reference screenshot, sized for the
     ONYX Boox Volta 3 (6", 1024x758, portrait width 758px):
     3 tiles of 242px + 2 gaps of 8px = 742px — exactly the 758px width
     minus the 8px+8px container padding (activity_main.xml).
     - cover on top (242 x 334px) inside a frame with 8px rounded corners
       (bg_cover_frame); the cover bitmap is clipped to the same shape by
       CoverLoader (Shape.ROUNDED_RECT),
     - a small format label pinned to the bottom-left corner of the cover,
     - the book title right under the cover.
     The whole tile (cover + label + title) is ONE clickable item — GridView
     dispatches item clicks over the entire child view. All tiles are exactly
     the same size: the root has a fixed 242px width matching the GridView's
     columnWidth (242px, stretchMode=none), so columns and tiles never diverge.
     Sizes are in px (the target device's screen pixels) so the design is exact
     on that hardware; the old design scaled at x2.42 (100dp -> 242px). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="242px"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/cover_frame"
        android:layout_width="match_parent"
        android:layout_height="328px"
        android:background="@drawable/bg_cover_frame">

        <!-- centerCrop: the cover is scaled (uniformly, no distortion) to fill the
             whole tile width AND height; the overflow is cropped at the edges. -->
        <ImageView
            android:id="@+id/book_grid_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Cover" />

        <!-- Books without a cover: a red circle with the title's initial, centered. -->
        <TextView
            android:id="@+id/book_grid_initial"
            android:layout_width="155px"
            android:layout_height="155px"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_red"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="68px"
            android:textStyle="bold" />

        <!-- Format label: fixed 116px width so every label is the same size
             (the longest one is "FB2ZIP"). -->
        <TextView
            android:id="@+id/book_grid_format"
            android:layout_width="116px"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="@drawable/bg_format_badge"
            android:gravity="center"
            android:paddingTop="5px"
            android:paddingBottom="5px"
            android:textColor="#303030"
            android:textSize="27px"
            android:textStyle="bold"
            android:maxLines="1" />

        <!-- Per-book kebab (Details / Edit metadata / Remove). Grid mode: top-right
             corner of the cover. Same 24dp button (icon + translucent circle
             backdrop) as the list row, so both view modes match in size. dp (not
             px) on purpose: the tile sizes its text in px for the target hardware,
             but the kebab must match the list row's 24dp footprint. -->
        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_kebab_circle">

            <ImageButton
                android:id="@+id/book_more"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_kebab_pressed"
                android:scaleType="centerInside"
                android:src="@drawable/ic_kebab"
                android:contentDescription="@string/more_options" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/book_grid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:textColor="#202020"
        android:textSize="29px"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
