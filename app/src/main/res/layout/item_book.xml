<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- The leading slot holds either the circular letter badge or, for formats that
         carry a cover (EPUB/FB2), the cover image at the same 48dp size. -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <TextView
            android:id="@+id/book_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@drawable/bg_circle"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/book_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Cover" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#202020"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/book_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#808080"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/book_format"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:textColor="@color/colorPrimary"
        android:textSize="12sp"
        android:maxLines="1" />

    <!-- Per-book kebab (Details / Edit metadata / Remove). List mode: at the row's
         right end, after the format label. Same 24dp footprint as the grid kebab.
         The icon lives in the stateful button background (bg_kebab_list_pressed):
         gray at rest, white over a darker circle when pressed — a plain dark
         ripple would hide the gray icon, so the pressed state flips it to white
         (the grid's pressed look) to keep it visible. -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp">

        <ImageButton
            android:id="@+id/book_more"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_kebab_list_pressed"
            android:contentDescription="@string/more_options" />
    </FrameLayout>
</LinearLayout>
