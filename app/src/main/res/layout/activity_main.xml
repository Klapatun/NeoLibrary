<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary"
        android:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp" />

            <ImageButton
                android:id="@+id/toggle_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_grid"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/view_grid"
                android:padding="8dp" />
        </RelativeLayout>

        <Spinner
            android:id="@+id/filter_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:prompt="@string/filter_all" />
    </LinearLayout>

    <!-- Stage-2 (background enrichment) status strip: visible only while the
         metadata/covers worker runs, never blocks the list below. -->
    <LinearLayout
        android:id="@+id/enrich_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#FFF3CD"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/enrich_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/enrich_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textSize="12sp"
            android:textColor="#7A5C00" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16px"
        android:paddingLeft="8px"
        android:paddingRight="8px">

        <ListView
            android:id="@+id/book_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice" />

        <!-- Uniform tiles, sized in px for the ONYX Boox Volta 3 (6", 1024x758):
             each tile is a fixed 242px wide (stretchMode=none, columnWidth=242px),
             8px between columns and between rows, and the number of columns
             AUTO-FITS the screen width: portrait 758px -> 3 per row (3x242 +
             2x8 = 742px fits the 742px available width), landscape 1024px ->
             4 per row (4x242 + 3x8 = 992px), wider screens -> even more.
             insideOverlay: the scrollbar floats above the content so it never
             steals width from the last column. -->
        <GridView
            android:id="@+id/book_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="auto_fit"
            android:verticalSpacing="8px"
            android:horizontalSpacing="8px"
            android:stretchMode="none"
            android:columnWidth="242px"
            android:scrollbarStyle="insideOverlay"
            android:verticalScrollbarPosition="defaultPosition"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_books_message"
            android:textColor="#808080"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_view_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_books_message"
            android:textColor="#808080"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
