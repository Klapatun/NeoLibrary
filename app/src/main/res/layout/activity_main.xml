<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary"
        android:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <!-- The filter spinner takes the start side of the header row and is
                 bounded by the action row on its right (one-way constraint: the
                 row stays alignParentEnd, so there is no circular dependency) —
                 the same pattern the former title TextView used. -->
            <Spinner
                android:id="@+id/filter_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/header_actions"
                android:layout_marginEnd="8dp"
                android:prompt="@string/filter_all" />

            <!-- Header actions in one row: the list/tiles toggle, then the
                 overflow kebab rightmost (the header's right corner). Import and
                 rescan live in the kebab's menu (main_menu) now, so the header
                 stays uncluttered. All icons are 48x48 white PNGs on the indigo
                 bar; each button keeps the selectable ripple. -->
            <LinearLayout
                android:id="@+id/header_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/toggle_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_list"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/view_list"
                    android:padding="8dp" />

                <ImageButton
                    android:id="@+id/btn_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_overflow"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/more_options"
                    android:padding="8dp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Stage-2 (background enrichment) status strip: visible only while the
         metadata/covers worker runs, never blocks the list below. -->
    <LinearLayout
        android:id="@+id/enrich_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#FFF3CD"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/enrich_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/enrich_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textSize="12sp"
            android:textColor="#7A5C00" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/book_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16px"
        android:paddingLeft="8px"
        android:paddingRight="8px">

        <!-- Tiles (the grid) are the DEFAULT view, so the list starts hidden;
             MainActivity.setViewMode() flips the visibilities on the first toggle
             (and on a persisted non-default choice). -->
        <ListView
            android:id="@+id/book_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice"
            android:visibility="gone" />

        <!-- Uniform tiles, sized in px for the ONYX Boox Volta 3 (6", 1024x758):
             each tile is a fixed 242px wide (stretchMode=none, columnWidth=242px),
             8px between columns and between rows, and the number of columns
             AUTO-FITS the screen width: portrait 758px -> 3 per row (3x242 +
             2x8 = 742px fits the 742px available width), landscape 1024px ->
             4 per row (4x242 + 3x8 = 992px), wider screens -> even more.
             insideOverlay: the scrollbar floats above the content so it never
             steals width from the last column. -->
        <GridView
            android:id="@+id/book_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="auto_fit"
            android:verticalSpacing="8px"
            android:horizontalSpacing="8px"
            android:stretchMode="none"
            android:columnWidth="242px"
            android:scrollbarStyle="insideOverlay"
            android:verticalScrollbarPosition="defaultPosition" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_books_message"
            android:textColor="#808080"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_view_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_books_message"
            android:textColor="#808080"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Pagination strip: visible only while pagination is on (the header kebab's
         "Add/Remove pagination"). Holo small buttons + the "page / pages" counter;
         MainActivity.updatePageIndicator() is the single place that drives the
         visibility and the button states. -->
    <LinearLayout
        android:id="@+id/pagination_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/page_prev"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_prev" />

        <TextView
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:minWidth="64dp"
            android:gravity="center"
            android:textColor="#202020"
            android:textSize="14sp" />

        <Button
            android:id="@+id/page_next"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_next" />
    </LinearLayout>
</LinearLayout>
