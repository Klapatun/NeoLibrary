<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Holo theme: the Material themes require API 21+, but the target device is
         Android 4.4.4 (API 19), so we use the Holo family which exists on that platform.
         No support/AndroidX dependency is needed.
         The Material color items (colorPrimary/colorPrimaryDark/colorAccent, API 21+)
         are not set here — they live in values-v21/styles.xml (NewApi). -->
    <style name="AppTheme" parent="android:Theme.Holo.Light">
        <item name="android:windowBackground">@color/windowBackground</item>
    </style>
</resources>
