<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- For Android 4.4+ KitKat multi-select storage access (SAF) based library import. -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetailActivity"
            android:exported="false" />

        <activity
            android:name=".EditMetaActivity"
            android:exported="false" />

        <!-- Read-only view over the catalog so the CursorLoader gets a real
             ContentObserver channel (see BookProvider). -->
        <provider
            android:name=".db.BookProvider"
            android:authorities="com.example.mylibrary.books"
            android:exported="false" />
    </application>
</manifest>
